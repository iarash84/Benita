// فارسی: تضمین می‌کند include_once یک کتابخانهٔ تکراری را فقط یک بار وارد کند.
// English: Verifies that include_once imports the same function library only once.
include_once "add-function-library.ben";
include_once "add-function-library.ben";

_main_() {
    number result = add(2, 3);
    print(result);
}
