// استفاده از متغیر سراسری در تابع و ترکیب scope سراسری و محلی را آزمایش می‌کند.
// Tests using a global variable in a function and combining global and local scopes.
number x = 10;
func add(number a, number b) -> number {
    number c = a + b;
    return a + b;
}

_main_() {
    number y = 20;
    number sum = add(x, y);
    Console.print(sum);
    string message = "Hello, World!";
    Console.print(message);
}
