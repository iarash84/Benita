// فارسی: تابع بولی تشخیص زوج بودن و انتخاب شاخهٔ if/else را آزمایش می‌کند.
// English: Tests a Boolean even-number function and if/else branch selection.
func is_even(number a) -> bool {
    return a % 2 == 0;
}

_main_() {
    number num = 12;           
    if (is_even(num)) {
        print("Sum is even.");
    } else {
        print("Sum is odd.");
    }   
}
