import Console;
import Array;
import Math;
// جست‌وجوی دودویی روی آرایهٔ مرتب و حالت‌های پیدا شدن و نشدن مقدار را نمایش می‌دهد.
// Demonstrates binary search on a sorted array for both found and missing values.
// Binary search requires a sorted array and repeatedly halves the search range.
func binary_search(number[] values, number target) -> number {
    number left = 0;
    number right = Array.length(values) - 1;

    while (left <= right) {
        number middle = Math.round((left + right) / 2);
        if (values[middle] == target) {
            return middle;
        }

        if (values[middle] < target) {
            left = middle + 1;
        } else {
            right = middle - 1;
        }
    }

    return -1;
}

_main_() {
    number[] values = [2, 5, 8, 12, 16, 23, 38];
    Console.print(binary_search(values, 16));
    Console.print(binary_search(values, 7));
}
