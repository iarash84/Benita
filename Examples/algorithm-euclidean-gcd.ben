// محاسبهٔ ب.م.م با الگوریتم تکرارشوندهٔ اقلیدس و عملگر باقی‌مانده را نمایش می‌دهد.
// Demonstrates iterative Euclidean GCD calculation and the remainder operator.
// Greatest common divisor using Euclid's iterative algorithm.
func gcd(number first, number second) -> number {
    while (second != 0) {
        number remainder = first % second;
        first = second;
        second = remainder;
    }

    return first;
}

_main_() {
    print(gcd(48, 18));
}
