// حذف و افزودن عناصر آرایه، محاسبهٔ طول و پیمایش نتیجه را آزمایش می‌کند.
// Tests removing and adding array elements, measuring length, and iterating the result.
_main_() {                                        
    number[] arr = [10, 20, 30, 40, 50];
    arr = Array.remove(arr , 2);
    arr = Array.add(arr, 60);
    arr = Array.add(arr, 70);
    number i = 0;            
    while (i < Array.length(arr)) {
        Console.print("Element at index " + i + ": " + arr[i]);
        i++;
    }                     
}
