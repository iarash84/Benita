// وجود فایل را بررسی و در صورت موجود بودن آن را حذف می‌کند.
// Checks whether a file exists and deletes it when present.
_main_() {
    File file = new File("test.txt");
    if (file.exists()) {
        file.delete();
        print("file deleted successfully");
    } else {
        print("File does not exist.");
    }
}
