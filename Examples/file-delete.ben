// فارسی: وجود فایل را بررسی و در صورت موجود بودن آن را حذف می‌کند.
// English: Checks whether a file exists and deletes it when present.
_main_() {
    string file_path = "test.txt";
    if (file_exist(file_path)) {
        file_delete(file_path);
        print("file deleted sucessfully");
    } else {
        print("File does not exist.");
    }
}
