import Terminal;
// خروج زودهنگام و return خالی در یک تابع void را آزمایش می‌کند.
// Tests early exit and empty return statements in a void function.
func test(number i) -> void
{
	Terminal.print("yess");
	if(i == 5){
		Terminal.print("five");
		return;
	}
	Terminal.print("Nop");
	return;
}

_main_(){
	test(5);
}
