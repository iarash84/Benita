import Console;
import Convert;
// نسخهٔ جایگزین تولید تکرارشوندهٔ فیبوناچی با ورودی کاربر را آزمایش می‌کند.
// Tests an alternate iterative Fibonacci implementation using user input.
_main_() {
    Console.print("Enter The Number Of Terms:");
    number n = Convert.to_number(Console.input());
    number f = 0; 
    number f1=-1; 
    number f2=1;
    Console.print("The Fibonacci Series is:");
    while(n>0)
    {
        f=f1+f2;
        f1=f2;
        f2=f;
        Console.print(f);
        n--;
    }                
}
