// عملیات بررسی وجود، خواندن و ساخت فایل با محتوای اولیه را آزمایش می‌کند.
// Tests file existence checks, reading, and creating a file with initial content.
number myVar;
string fileContent;

_main_() {
    File file = new File("test.txt");
    if (file.exists()) {
        Console.print(file.readText());
    } else {
        Console.print("File does not exist, creating new file with content.");
        file.writeText("Hello, world!");
    }
}
