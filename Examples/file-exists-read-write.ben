// عملیات بررسی وجود، خواندن و ساخت فایل با محتوای اولیه را آزمایش می‌کند.
// Tests file existence checks, reading, and creating a file with initial content.
number myVar;
string fileContent;

_main_() {
    if (file_exist("test.txt")) {
        fileContent = file_read("test.txt");
        print(fileContent);
    } else {
        print("File does not exist, creating new file with content.");
        file_write("test.txt", "Hello, world!");
    }
}
