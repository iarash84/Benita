import Terminal;
import Error;
// پرتاب error، خواندن code و message در catch و اجرای تضمینی finally را آزمایش می‌کند.
// Tests throwing an error, reading code/message in catch, and guaranteed finally execution.
func validate(number value) -> number {
    if (value < 0) {
        throw Error.create("VALUE100", "Value cannot be negative");
    }
    return value;
}

_main_() {
    try {
        Terminal.print(validate(-1));
    } catch (failure) {
        Terminal.print(failure.code + ": " + failure.message);
    } finally {
        Terminal.print("Validation finished");
    }
}
