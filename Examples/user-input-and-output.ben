import Terminal;
// دریافت یک رشته از ورودی استاندارد و چاپ دوبارهٔ آن را نمایش می‌دهد.
// Demonstrates reading a string from standard input and printing it back.
_main_() {
    Terminal.print("Enter your name ");
    string message = Terminal.input();
    Terminal.print("your name is ");
    Terminal.print(message);
}
