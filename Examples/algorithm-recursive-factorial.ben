// فاکتوریل بازگشتی و شرط توقف برای صفر و یک را آزمایش می‌کند.
// Tests recursive factorial with base cases for zero and one.
// Recursive factorial with a base case for zero and one.
func factorial(number value) -> number {
    if (value <= 1) {
        return 1;
    }

    return value * factorial(value - 1);
}

_main_() {
    print(factorial(6));
}
