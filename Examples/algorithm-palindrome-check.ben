import Console;
import String;
// تشخیص palindrome را با مقایسهٔ نویسه‌های متن از ابتدا و انتها آزمایش می‌کند.
// Tests palindrome detection by comparing characters from both ends of a string.
// A palindrome reads identically from left to right and from right to left.
func is_palindrome(string value) -> bool {
    number left = 0;
    number right = String.length(value) - 1;

    while (left < right) {
        if (String.char_at(value, left) != String.char_at(value, right)) {
            return false;
        }

        left++;
        right--;
    }

    return true;
}

_main_() {
    Console.print(is_palindrome("level"));
    Console.print(is_palindrome("benita"));
    Console.print(is_palindrome(""));
}
