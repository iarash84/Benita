// فارسی: جست‌وجوی خطی با for-in و نتیجهٔ منفی برای مقدار پیدا‌نشده را آزمایش می‌کند.
// English: Tests linear search with for-in and a negative result for a missing value.
// Linear search works on unsorted arrays and returns -1 when no item matches.
func linear_search(number[] values, number target) -> number {
    number index = 0;
    for (value in values) {
        if (value == target) {
            return index;
        }
        index++;
    }

    return -1;
}

_main_() {
    number[] values = [14, 3, 27, 8, 19];
    print(linear_search(values, 8));
    print(linear_search(values, 100));
}
