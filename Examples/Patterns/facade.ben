// الگوی Facade سرویس‌های موجودی و پرداخت را پشت API سادهٔ checkout قرار می‌دهد.
// Demonstrates Facade by placing inventory and payment services behind a simple checkout API.
pkg InventoryService {
    init() { }

    public func is_available(number count) -> bool {
        return count > 0;
    }
}

pkg PaymentService {
    init() { }

    public func pay(number amount) -> bool {
        return amount > 0;
    }
}

pkg ShopFacade {
    InventoryService inventory = new InventoryService();
    PaymentService payment = new PaymentService();

    init() { }

    public func checkout(number count, number amount) -> string {
        if (!inventory.is_available(count)) {
            return "Out of stock";
        }

        if (!payment.pay(amount)) {
            return "Payment failed";
        }

        return "Order completed";
    }
}

_main_() {
    ShopFacade shop = new ShopFacade();
    print(shop.checkout(2, 150));
}
